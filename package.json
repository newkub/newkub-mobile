{
  "name": "newkub-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal customizable app — Clock, Tasks, Devin, Notes, Saved, Email tabs on Cloudflare Workers + Android (Capacitor 8)",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "build:spa": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "tsc -b --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cap:sync": "bun run build:spa && cap sync android",
    "cap:copy": "bun run build:spa && cap copy android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "cap:add:android": "cap add android",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
